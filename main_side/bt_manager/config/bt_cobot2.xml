<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <BehaviorTree ID="BehaviorTree">
        <KeepRunningUntilFailure>
            <Sequence>
                <Action ID="PopNextTask" estop_flag="{estop_flag}" llm_json="{llm_json}" action_name="{action}" target_name="{target}"/>
                
                <Fallback name="ActionPreparation">
                    
                    <Sequence name="TargetRequiredBranch">
                        <Condition ID="IsTargetRequired" target_name="{target}"/>
                        
                        <Fallback name="SearchLogic">
                            <Condition ID="IsTargetLocated" target_name="{target}"/>
                            <Action ID="ExecutePythonAction" action_name="detect_in_place" target_name="{target}"/>
                            <Action ID="ExecutePythonAction" action_name="finding" target_name="{target}"/>
                        </Fallback>
                        
                        <Action ID="ExecutePythonAction" action_name="approach" target_name="{target}"/>
                    </Sequence>
                    
                    <Sequence name="NoTargetBranch">
                        <Inverter>
                            <Condition ID="IsTargetRequired" target_name="{target}"/>
                        </Inverter>
                        <Fallback name="GripVerification">
                            <Condition ID="IsResetAction" action_name="{action}"/>
                            <Action ID="ExecutePythonAction" action_name="check_grip" target_name="none"/>
                        </Fallback>
                    </Sequence>
                </Fallback>

                <Action ID="ExecutePythonAction" action_name="{action}" target_name="{target}"/>
            </Sequence>
        </KeepRunningUntilFailure>
    </BehaviorTree>
    
    <TreeNodesModel>
        <Action ID="ExecutePythonAction">
            <input_port default="{action}" name="action_name"/>
            <input_port default="{target}" name="target_name"/>
        </Action>
        <Condition ID="IsResetAction">
            <input_port name="action_name"/>
        </Condition>
        <Condition ID="IsTargetLocated">
            <input_port default="{target}" name="target_name"/>
        </Condition>
        <Condition ID="IsTargetRequired">
            <input_port default="{target}" name="target_name"/>
        </Condition>
        <Action ID="PopNextTask">
            <input_port name="llm_json"/>
            <input_port name="estop_flag"/>
            <output_port default="{action}" name="action_name"/>
            <output_port default="{target}" name="target_name"/>
        </Action>
    </TreeNodesModel>
</root>