<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rokey</name>
  <version>0.0.0</version>
  <description>ROKEY BOOT CAMP Package</description>
  <maintainer email="dlacksdn352@gmail.com">sparkx</maintainer>
